# Server
SERVER_PORT=8080

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Either provide a path to a credentials file:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# Or provide the JSON content directly (useful for Docker/CI):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# OpenAQ API key — register free at https://explore.openaq.org
OPENAQ_API_KEY=your-openaq-api-key

# External API base URLs (override for testing or if course servers change)
COUNTRIES_API_URL=http://129.241.150.113:8080/v3.1
METEO_API_URL=https://api.open-meteo.com/v1
OPENAQ_API_URL=https://api.openaq.org/v3
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
CURRENCY_API_URL=http://129.241.150.113:9090/currency

# Cache settings (advanced)
# CACHE_TTL_HOURS overrides all per-type TTLs when set (default: per-type values)
# CACHE_PURGE_INTERVAL_HOURS=1
